# ========== MODEL CONFIGURATION ==========

# Claude Model
CLAUDE_MODEL=claude-sonnet-4.5
CLAUDE_TEMPERATURE=0.1
CLAUDE_MAX_TOKENS=2048

# Whisper Model
WHISPER_MODEL=whisper-1
WHISPER_LANGUAGE=en

# Embeddings
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536


# ========== PINECONE SETTINGS ==========

PINECONE_INDEX_NAME=vet-knowledge-base
PINECONE_NAMESPACE=veterinary
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# RAG Thresholds
RAG_HIGH_CONFIDENCE_THRESHOLD=0.80
RAG_LOW_CONFIDENCE_THRESHOLD=0.60
RAG_TOP_K=5


# ========== ELEVENLABS SETTINGS ==========

ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_turbo_v2
ELEVENLABS_STABILITY=0.5
ELEVENLABS_SIMILARITY_BOOST=0.75


# ========== PERFORMANCE TARGETS ==========

TARGET_LATENCY_MS=2000
WHISPER_ACCURACY_TARGET=0.98
HALLUCINATION_REDUCTION_TARGET=0.85
DIAGNOSTIC_ACCURACY_IMPROVEMENT=0.15


# ========== SERVER CONFIGURATION ==========

HOST=0.0.0.0
PORT=8000
DEBUG=False
LOG_LEVEL=INFO
LOG_FORMAT=json


# ========== CACHING (Optional) ==========

ENABLE_REDIS_CACHE=False
REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=3600


# ========== WEB SEARCH ==========

TAVILY_MAX_RESULTS=3
TAVILY_SEARCH_DEPTH=advanced